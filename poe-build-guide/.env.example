# Maxroll.gg Integration Configuration

# API Configuration
REACT_APP_MAXROLL_BASE_URL=https://maxroll.gg/poe

# Cache Configuration
REACT_APP_CACHE_TTL=3600
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_PERSISTENCE=true

# Rate Limiting Configuration
REACT_APP_RATE_LIMIT_MAX=10
REACT_APP_RATE_LIMIT_WINDOW=60
REACT_APP_RATE_LIMIT_MIN_DELAY=1000

# Feature Flags
REACT_APP_ENABLE_OFFLINE_MODE=true
REACT_APP_ENABLE_DEBUG_LOGGING=false

# External Links
REACT_APP_POE_NINJA_URL=https://poe.ninja
REACT_APP_POE_TRADE_URL=https://www.pathofexile.com/trade
